# 复制到 ~/.config/supergames/game-idea.env 后，将权限设置为 600。
# 不要把真实密钥提交进 Git。

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
GITHUB_TOKEN=github_pat_your_fine_grained_token

GITHUB_REPOSITORY=zidanDirk/supergames
SUPERGAMES_REPO_DIR=/opt/supergames

# cron 的 PATH 通常很短，推荐填写服务器上的绝对路径：command -v claude / node
CLAUDE_BIN=/usr/local/bin/claude
NODE_BIN=/usr/bin/node

DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# DeepSeek V4.1 Flash 当前使用稳定 API 名 deepseek-flash。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_EFFORT=max
CLAUDE_MAX_TURNS=30
CLAUDE_TIMEOUT_MS=2700000
GAME_IDEA_MAX_ATTEMPTS=2
TZ=Asia/Shanghai

# 仅添加仓库中已经存在的标签；不存在时脚本会自动跳过，不影响 Issue 创建。
GAME_IDEA_LABELS=game-idea,daily-research

# 首次部署时可临时设为 1，只打印结果、不创建 Issue。
DRY_RUN=0
